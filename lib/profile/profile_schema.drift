CREATE TABLE profiles (
  profile_id TEXT NOT NULL PRIMARY KEY CHECK(length(profile_id) = 36 AND profile_id = lower(profile_id)
    AND profile_id GLOB '????????-????-4???-[89ab]???-????????????'
    AND NOT ("replace"(profile_id, '-', '') GLOB '*[^0-9a-f]*')),
  display_name TEXT CHECK(display_name IS NULL OR length(trim(display_name)) > 0),
  avatar_key TEXT NOT NULL CHECK(avatar_key IN ('island_01', 'island_02', 'island_03', 'island_04')),
  created_at_utc INTEGER NOT NULL,
  updated_at_utc INTEGER NOT NULL,
  stats_started_at_utc INTEGER NOT NULL
);

CREATE TABLE match_records (
  match_id TEXT NOT NULL PRIMARY KEY CHECK(length(match_id) = 36 AND match_id = lower(match_id)
    AND match_id GLOB '????????-????-4???-[89ab]???-????????????'
    AND NOT ("replace"(match_id, '-', '') GLOB '*[^0-9a-f]*')),
  profile_id TEXT NOT NULL REFERENCES profiles(profile_id),
  execution_id TEXT NOT NULL CHECK(length(execution_id) = 36 AND execution_id = lower(execution_id)
    AND execution_id GLOB '????????-????-4???-[89ab]???-????????????'
    AND NOT ("replace"(execution_id, '-', '') GLOB '*[^0-9a-f]*')),
  session_kind TEXT NOT NULL CHECK(session_kind = 'normal'),
  origin TEXT NOT NULL CHECK(origin = 'gameplay'),
  game_mode TEXT NOT NULL CHECK(game_mode = 'player_vs_cpu'),
  difficulty TEXT NOT NULL CHECK(difficulty IN ('very_easy', 'easy', 'normal', 'hard')),
  player_cpu_difficulty TEXT NOT NULL CHECK(player_cpu_difficulty IN ('very_easy', 'easy', 'normal', 'hard')),
  island_count INTEGER NOT NULL CHECK(island_count BETWEEN 8 AND 16),
  status TEXT NOT NULL CHECK(status IN ('in_progress', 'completed', 'abandoned', 'interrupted')),
  outcome TEXT CHECK(outcome IN ('win', 'loss', 'draw')),
  started_at_utc INTEGER NOT NULL,
  ended_at_utc INTEGER,
  recovered_at_utc INTEGER,
  elapsed_ms INTEGER CHECK(elapsed_ms >= 0),
  dispatch_count INTEGER CHECK(dispatch_count >= 0),
  forces_sent INTEGER CHECK(forces_sent >= 0),
  captures INTEGER CHECK(captures >= 0),
  app_version TEXT NOT NULL CHECK(length(trim(app_version)) > 0),
  rules_version TEXT NOT NULL CHECK(length(trim(rules_version)) > 0),
  metrics_version INTEGER NOT NULL CHECK(metrics_version >= 1),
  receipt_xp INTEGER CHECK(receipt_xp >= 0),
  receipt_before INTEGER CHECK(receipt_before >= 0),
  receipt_after INTEGER CHECK(receipt_after >= 0),
  receipt_reward_version TEXT,
  UNIQUE(match_id, profile_id),
  CHECK(
    (status = 'in_progress' AND outcome IS NULL AND ended_at_utc IS NULL AND recovered_at_utc IS NULL
      AND elapsed_ms IS NULL AND dispatch_count IS NULL AND forces_sent IS NULL AND captures IS NULL
      AND receipt_xp IS NULL AND receipt_before IS NULL AND receipt_after IS NULL AND receipt_reward_version IS NULL)
    OR
    (status IN ('completed', 'abandoned', 'interrupted')
      AND receipt_xp IS NOT NULL AND receipt_before IS NOT NULL AND receipt_after IS NOT NULL
      AND receipt_reward_version IS NOT NULL AND length(trim(receipt_reward_version)) > 0
      AND receipt_after = receipt_before + receipt_xp
      AND (outcome IS 'win' OR receipt_xp = 0)
      AND (
        (status = 'completed' AND outcome IS NOT NULL AND ended_at_utc IS NOT NULL AND recovered_at_utc IS NULL
          AND elapsed_ms IS NOT NULL AND dispatch_count IS NOT NULL AND forces_sent IS NOT NULL AND captures IS NOT NULL)
        OR (status = 'abandoned' AND outcome IS NULL AND ended_at_utc IS NOT NULL AND recovered_at_utc IS NULL
          AND elapsed_ms IS NOT NULL AND dispatch_count IS NOT NULL AND forces_sent IS NOT NULL AND captures IS NOT NULL)
        OR (status = 'interrupted' AND outcome IS NULL AND ended_at_utc IS NULL AND recovered_at_utc IS NOT NULL
          AND elapsed_ms IS NULL AND dispatch_count IS NULL AND forces_sent IS NULL AND captures IS NULL)
      ))
  )
);

CREATE INDEX match_history ON match_records(profile_id, started_at_utc DESC, match_id DESC);
CREATE INDEX match_statistics ON match_records(profile_id, status, session_kind, difficulty, island_count);
CREATE INDEX match_execution ON match_records(profile_id, execution_id, status);

CREATE TABLE xp_entries (
  entry_id TEXT NOT NULL PRIMARY KEY,
  profile_id TEXT NOT NULL REFERENCES profiles(profile_id),
  match_id TEXT,
  reason TEXT NOT NULL CHECK(reason IN ('legacy_import', 'match_victory')),
  amount INTEGER NOT NULL CHECK(amount >= 0),
  reward_version TEXT NOT NULL CHECK(length(trim(reward_version)) > 0),
  total_xp_before INTEGER NOT NULL CHECK(total_xp_before >= 0),
  total_xp_after INTEGER NOT NULL CHECK(total_xp_after = total_xp_before + amount),
  created_at_utc INTEGER NOT NULL,
  FOREIGN KEY(match_id, profile_id) REFERENCES match_records(match_id, profile_id),
  UNIQUE(match_id, reason),
  CHECK((reason = 'legacy_import' AND match_id IS NULL AND entry_id = 'legacy:' || profile_id)
     OR (reason = 'match_victory' AND match_id IS NOT NULL AND amount > 0))
);

CREATE UNIQUE INDEX legacy_import_once ON xp_entries(profile_id) WHERE reason = 'legacy_import';

CREATE TRIGGER victory_matches_receipt BEFORE INSERT ON xp_entries
WHEN NEW.reason = 'match_victory'
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM match_records WHERE match_id = NEW.match_id AND profile_id = NEW.profile_id
      AND status = 'completed' AND outcome = 'win' AND receipt_xp = NEW.amount
      AND receipt_before = NEW.total_xp_before AND receipt_after = NEW.total_xp_after
      AND receipt_reward_version = NEW.reward_version
  ) THEN RAISE(ABORT, 'XP does not match victory receipt') END;
END;

CREATE TABLE storage_meta (
  "key" TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);
