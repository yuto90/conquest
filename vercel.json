{
  "headers": [
    {
      "source": "/sqlite3.wasm",
      "headers": [{"key": "Content-Type", "value": "application/wasm"}]
    },
    {
      "source": "/drift_worker.js",
      "headers": [{"key": "Content-Type", "value": "text/javascript"}]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ]
}
